{
  "name": "scamshield",
  "version": "1.0.0",
  "description": "Anti-scam co-pilot - System tray application with background monitoring",
  "main": "./out/main/index.js",
  "author": "ScamShield",
  "license": "MIT",
  "scripts": {
    "dev": "node scripts/run-build-then-start.js",
    "dev:vite": "electron-vite dev",
    "dev:verbose": "ELECTRON_ENABLE_LOGGING=1 electron-vite dev",
    "build": "electron-vite build",
    "start": "electron .",
    "build:start": "npm run build && npm run start",
    "clean": "node -e \"require('fs').rmSync('out', { recursive: true, force: true })\"",
    "preview": "electron-vite preview",
    "postinstall": "electron-builder install-app-deps",
    "test": "jest",
    "test:watch": "jest --watch",
    "test:coverage": "jest --coverage",
    "test:e2e": "playwright test",
    "test:perf": "jest --config jest.config.cjs --testPathPattern=\"tests/performance\" --no-cache",
    "test:firefox-url": "npx ts-node tests/test-firefox-extraction.ts"
  },
  "dependencies": {
    "active-win": "^9.0.0",
    "dotenv": "^16.4.5",
    "electron-store": "8.1.0",
    "electron-updater": "^6.3.9",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "react-router-dom": "^6.28.0",
    "recharts": "^2.15.4",
    "sharp": "^0.34.5",
    "tesseract.js": "^5.0.4"
  },
  "optionalDependencies": {
    "@cherrystudio/mac-system-ocr": "^0.2.7"
  },
  "overrides": {
    "electron-store": "8.1.0"
  },
  "devDependencies": {
    "@playwright/test": "^1.49.0",
    "@testing-library/jest-dom": "^6.6.3",
    "@testing-library/react": "^16.0.1",
    "@types/jest": "^29.5.14",
    "@types/node": "^22.10.1",
    "@types/react": "^18.3.12",
    "@types/react-dom": "^18.3.1",
    "@vitejs/plugin-react": "^4.3.4",
    "electron": "^39.8.0",
    "electron-builder": "^25.1.8",
    "electron-vite": "^2.3.0",
    "jest": "^29.7.0",
    "jest-environment-jsdom": "^29.7.0",
    "ts-jest": "^29.2.5",
    "typescript": "^5.6.3",
    "vite": "^5.4.11"
  },
  "build": {
    "appId": "com.scamshield.app",
    "productName": "ScamShield",
    "directories": {
      "output": "release"
    },
    "files": [
      "out/**/*",
      "assets/**/*"
    ],
    "publish": {
      "provider": "generic",
      "url": "https://releases.scamshield.app/updates"
    },
    "mac": {
      "category": "public.app-category.utilities",
      "icon": "assets/icons/icon.icns",
      "target": [
        "dmg",
        "zip"
      ],
      "hardenedRuntime": true,
      "gatekeeperAssess": false,
      "entitlements": "build/entitlements.mac.plist",
      "entitlementsInherit": "build/entitlements.mac.plist"
    },
    "win": {
      "target": [
        "nsis",
        "portable"
      ],
      "icon": "assets/icons/icon.ico"
    },
    "linux": {
      "target": [
        "AppImage",
        "deb"
      ],
      "icon": "assets/icons",
      "category": "Utility"
    },
    "nsis": {
      "oneClick": false,
      "allowToChangeInstallationDirectory": true
    }
  }
}
